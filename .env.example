# SGLang Qwen3.8-27B (NVFP4) — DSpark speculative decoding.
# Copy to .env and adjust. Both setup.sh and run-sglang-*.sh read this file.
# Self-contained by default: no user-specific paths or central store required.

# ---- image ----
# Prebuilt SGLang runtime (bundles SGLang + CUDA + SM120 FlashInfer FP4 GEMM,
# no JIT/compile). `qwen38-27b` is the validated Blackwell/RTX 5090 tag.
# Alternative: qwen38-27b-cu129 (explicit CUDA 12.9).
SGGLANG_IMAGE=lmsysorg/sglang:qwen38-27b

# ---- weights / drafter (point these at any other model to reuse the stack) ----
# Target checkpoint (NVFP4, lm_head quantized to NVFP4).
MODEL_REPO=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090-LMHead4
MODEL_SUBDIR=Qwen3.8-27B-NVFP4-RTX5090-LMHead4
# Matching DSpark drafter (speculative-decoding draft model; ~1.4 GB).
DRAFTER_REPO=gittensor-model-hub/Qwen3.8-27B-DSpark-NVFP4
DRAFTER_SUBDIR=Qwen3.8-27B-DSpark-NVFP4
# Pin a known-good revision (empty = always latest).
MODEL_REVISION=
DRAFTER_REVISION=

# Where weights are stored. Default (unset) = ./models, self-contained inside
# this repo. Set to a shared dir (e.g. $HOME/models) to reuse one store across
# stacks; setup.sh then symlinks ./models/<subdir> -> $MODELS_ROOT/<subdir>.
#MODELS_ROOT=

# ---- container / host port ----
CONTAINER_NAME=sglang-qwen38
HOST_PORT=8040
CONTAINER_PORT=30000

# ---- auth (optional; SGLang exposes OpenAI /v1 + Anthropic /anthropic) ----
# Empty = no auth (localhost/LAN only). Set for external exposure.
API_KEY=

# ---- downloads ----
# setup.sh `hf download`. Public repos work without a token; set for gated repos.
#HF_TOKEN=
HF_HUB_ACCESS_TOKEN=
# Xet high-performance transfer (fast, resumable).
HF_XET_HIGH_PERFORMANCE=1

# ---- monitoring (docker-compose.yml: caddy/prometheus/grafana/dcgm) ----
# Bring up:  podman-compose -f docker-compose.yml up -d   (or ./monitor.sh up)
#GRAFANA_HOST_PORT=8042
#GATEWAY_HOST_PORT=8041
#PROMETHEUS_HOST_PORT=9091
# Grafana login (http://localhost:8042, applied on first grafana_data_sglang init).
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=
# HTTP Basic auth for the caddy gateway (fail-closed if METRICS_HASH is empty).
# METRICS_HASH = bcrypt hash of METRICS_PASSWORD:
#   python3 -c "import bcrypt;print(bcrypt.hashpw(input().encode(),bcrypt.gensalt(12)).decode()).replace('$2b$','$2a$')"
#METRICS_USER=metrics
#METRICS_PASSWORD=
#METRICS_HASH=
