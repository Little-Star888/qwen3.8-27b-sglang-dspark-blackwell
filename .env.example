# SGLang Qwen3.8-27B (NVFP4) — DFlash2 speculative decoding (default).
# Copy to .env and adjust. Both setup.sh and run-sglang-*.sh read this file.
# Self-contained by default: no user-specific paths or central store required.
#
# DEFAULT recipe = DFlash2 (z-lab block-diffusion drafter, the steady winner).
# ALTERNATIVE = DSpark (autoregressive drafter, higher burst ceiling).
# Each recipe has its OWN image + drafter knob so they never re-point each other.

# ---- image (DEFAULT DFlash2 recipe) ----
# DFlash2 needs a NEWER SGLang than the DSpark image: DFlash2DraftModel only
# exists upstream from 2026-08-19 (#35371) + quantized-lm_head selector
# 2026-08-20 (#35496) — the DSpark image (qwen38-27b, 2026-08-14) predates
# both. The dflash presets use this knob; the DSpark presets use SGGLANG_IMAGE.
DFLASH_SGLANG_IMAGE=lmsysorg/sglang:nightly-dev-cu13-20260830-a1fe4e30

# ---- target checkpoint (shared by both recipes) ----
MODEL_REPO=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090-LMHead4
MODEL_SUBDIR=Qwen3.8-27B-NVFP4-RTX5090-LMHead4
# Pin a known-good revision (empty = always latest).
MODEL_REVISION=

# ---- DFlash2 drafter (DEFAULT; run-sglang-dflash*.sh presets) ----
# z-lab block-diffusion drafter (~3.6 GB BF16): drafts a whole block in one
# denoise step. Downloads with ./setup.sh dflash2 (or the default ./setup.sh).
# Own knob pair, separate from DRAFTER_REPO/SUBDIR, so the DSpark launchers
# are never re-pointed.
DFLASH_DRAFTER_SUBDIR=Qwen3.8-27B-DFlash2
#DFLASH2_REPO=z-lab/Qwen3.8-27B-DFlash2
# DFlash2 draft pool is bounded by DRAFT_WINDOW_SIZE (a target-token window in
# the drafter's own KV cache) — NOT by the target ctx, so the DFLASH presets
# keep the full ctx budget (237568 text-only / 150000 vision):
#   DFLASH_BLOCK_SIZE    verify window = N draft tokens (default 8)
#   DRAFT_WINDOW_SIZE    draft target-token window cap (default 16384)
#   CONTEXT_LENGTH       237568 text-only / 150000 vision default
#   MEM_FRACTION_STATIC  0.91 DFlash text-only / 0.88 DSpark text-only / 0.82 vision default
#DFLASH_BLOCK_SIZE=8
#DRAFT_WINDOW_SIZE=16384

# ---- DSpark drafter (ALTERNATIVE; run-sglang-godspeed.sh / run-sglang-vision.sh) ----
# DSpark image + drafter are brought up with ./setup.sh dspark.
SGGLANG_IMAGE=lmsysorg/sglang:qwen38-27b
# DSpark drafter (speculative-decoding draft model). Default: the BF16
# RadixArk build (~2.6 GB) — better accept length on the 5090.
DRAFTER_REPO=RadixArk/Qwen3.8-27B-DSpark
DRAFTER_SUBDIR=Qwen3.8-27B-DSpark-BF16
DRAFTER_REVISION=
# Drafter dtype: unquant = the BF16 drafter (the default). To opt out to the
# smaller NVFP4 drafter, run ./setup.sh nvfp4-drafter and set:
#   DRAFTER_REPO=gittensor-model-hub/Qwen3.8-27B-DSpark-NVFP4
#   DRAFTER_SUBDIR=Qwen3.8-27B-DSpark-NVFP4
#   DRAFT_MODEL_QUANTIZATION=modelopt_fp4
#   DRAFT_MODEL_QUANTIZATION=unquant
# DSpark draft block gamma: godspeed default 7, vision default 5.
#DSPARK_BLOCK_SIZE=7
# optional NVFP4 DSpark drafter repo/subdir (see ./setup.sh nvfp4-drafter)
#DRAFTER_NVFP4_REPO=gittensor-model-hub/Qwen3.8-27B-DSpark-NVFP4
#DRAFTER_NVFP4_SUBDIR=Qwen3.8-27B-DSpark-NVFP4

# ---- where weights are stored ----
# Default (unset) = ./models, self-contained inside this repo. Set to a
# shared dir (e.g. $HOME/models) to reuse one store across stacks; setup.sh
# then symlinks ./models/<subdir> -> $MODELS_ROOT/<subdir>.
#MODELS_ROOT=

# ---- sizing knobs (shared by both recipes; per-preset defaults) ----
# mamba slot count. 5 slots (old default) stall at 3–14 tok/s on long
# multi-turn sessions: cached-prefix accumulation fills 4/5 slots (~180K ctx)
# and triggers eviction-recompute. 8 slots removes it, costing ~5K of the
# token pool.
#MAX_MAMBA_CACHE_SIZE=8
# mamba radix-cache strategy (all presets, DFlash2 + DSpark + vision):
#   extra_buffer_lazy  default — measured on this 5090 on 2026-09-04: +5,863
#                      tokens of KV pool vs eager (89,083 → 94,946), no
#                      quality cost. The old "image hard-asserts unsupported
#                      with DFLASH" note was wrong for the 2026-08-30 image.
#   extra_buffer       eager fallback (ping-pong buffer pair); use only if a
#                      future SGLang image breaks lazy.
# MAMBA_RADIX_CACHE_STRATEGY=extra_buffer_lazy
# target-model VRAM fraction: DFlash text-only default 0.90 (verified ~94K
# pool), DSpark text-only 0.88, vision 0.82.
# This is the primary KV-pool dial (pool ≈ KV GB × 32,768 tokens; FP8 cache).
#MEM_FRACTION_STATIC=
# nominal context cap (default 80000, matches the measured pool on this 5090).
# It costs no VRAM and is a ceiling, not a budget — requests must still fit
# the KV token pool. Raise only if you've grown the pool (mfs / draft window)
# and want a bigger *requested* ceiling.
#CONTEXT_LENGTH=
# ---- the current pool recipe (DFlash2 text-only, measured 2026-09-04) ----
# mfs 0.90 + DRAFT_WINDOW_SIZE 8192 + lazy mamba => 94,946-token pool
# (sglang:max_total_num_tokens), max_req_input_len 79,994. The old 128K
# recipe (mfs 0.91 + window 16384) is retired — see README "Context pool".
#   MEM_FRACTION_STATIC=0.90       # primary pool dial (script default)
#   DRAFT_WINDOW_SIZE=8192         # extra lever: shrinks the DFlash2 draft KV pool
# Also cap the client context_length to the pool (README: "Client cap").
#

# ---- container / host port ----
CONTAINER_NAME=sglang-qwen38
HOST_PORT=8040
CONTAINER_PORT=30000

# ---- served model id (what /v1/models reports + clients pass as "model") ----
# All presets pass --served-model-name, so the id is stable instead of the
# container path "/model". Override per-stack if you run several stacks.
#SERVED_MODEL_NAME=qwen3.8-27b-nvfp4

# Qwen3.8 thinking/reasoning knobs -> SGLang --default-chat-template-kwargs.
# JSON dict applied to every request; per-request chat_template_kwargs wins.
#   reasoning_effort : medium (launcher default) | xhigh | low   ("none" = off)
#   enable_thinking  : true (default) | false
#   preserve_thinking: true (default) | false  (keeps prior-turn thinking in
#                                              the prompt; costs tokens, helps
#                                              continued conversations)
# Unset = launcher default {"reasoning_effort":"medium"}
# (template-native default is xhigh; set it explicitly to opt back in).
# Examples:
#DEFAULT_CHAT_TEMPLATE_KWARGS={"reasoning_effort":"xhigh"}
#DEFAULT_CHAT_TEMPLATE_KWARGS={"reasoning_effort":"low","enable_thinking":true}

# ---- auth (optional; SGLang exposes OpenAI /v1 + Anthropic /anthropic) ----
# Empty = no auth (localhost/LAN only). Set for external exposure.
API_KEY=

# ---- downloads ----
# setup.sh `hf download`. Public repos work without a token; set for gated repos.
#HF_TOKEN=
HF_HUB_ACCESS_TOKEN=
# Xet high-performance transfer (fast, resumable).
HF_XET_HIGH_PERFORMANCE=1

# ---- monitoring (docker-compose.yml: caddy/prometheus/grafana/dcgm) ----
# Bring up:  podman-compose -f docker-compose.yml up -d   (or ./monitor.sh up)
#GRAFANA_HOST_PORT=8042
#GATEWAY_HOST_PORT=8041
#PROMETHEUS_HOST_PORT=9091
# Grafana login (http://localhost:8042, applied on first grafana_data_sglang init).
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=
# HTTP Basic auth for the caddy gateway (fail-closed if METRICS_HASH is empty).
# METRICS_HASH = bcrypt hash of METRICS_PASSWORD:
#   python3 -c "import bcrypt;print(bcrypt.hashpw(input().encode(),bcrypt.gensalt(12)).decode()).replace('$2b$','$2a$')"
#METRICS_USER=metrics
#METRICS_PASSWORD=
#METRICS_HASH=
